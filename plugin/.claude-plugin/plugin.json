{
  "name": "token-bay",
  "version": "0.0.0-dev",
  "description": "Claude Code plugin for the Token-Bay educational distributed rate-limit sharing network.",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/token-bay-sidecar hooks StopFailure --config ${HOME}/.token-bay/config.yaml",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/token-bay-sidecar hooks SessionStart --config ${HOME}/.token-bay/config.yaml",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/token-bay-sidecar hooks SessionEnd --config ${HOME}/.token-bay/config.yaml",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/token-bay-sidecar hooks UserPromptSubmit --config ${HOME}/.token-bay/config.yaml",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
